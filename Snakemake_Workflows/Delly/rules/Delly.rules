rule vcf_to_bed:
    input:
        vcf = "Delly/Filtered_vcf_files/{SVtype}/{sample}.genome.delly.{SVtype}.filtered.{date}.vcf"
    output:
        bed = "Delly/Bed_files/{SVtype}/{sample}.genome.delly.{SVtype}.filtered.{date}.bed"
    params:
        bedops_bin = parameters.bedops_bin
    resources:
        nb_cores = 1,
        mem_mb   = 1000,
    shell:
        """
        mkdir -p Delly/Bed_files/{wildcards.SVtype}
        export PATH={params.bedops_bin}:$PATH
        convert2bed --input=vcf < {input.vcf} > {output.bed}
        """

rule all_delly:
    input:
        expand(
            "Delly/Unfiltered_vcf_files/{sample}.genome.delly.{date}.vcf",
            sample=config["samples"],
            date=[parameters.date],
        ),
        expand(
            "Delly/Filtered_vcf_files/{SVtype}/{sample}.genome.delly.{SVtype}.filtered.{date}.vcf",
            sample=config["samples"],
            SVtype=["del-max10kb", "del-gt10kb", "dup", "inv"],
            date=[parameters.date],
        ),
        expand(
            "Delly/Bed_files/{SVtype}/{sample}.genome.delly.{SVtype}.filtered.{date}.bed",
            sample=config["samples"],
            SVtype=["del-max10kb", "del-gt10kb", "dup", "inv"],
            date=[parameters.date],
        )
    output:
        touch("all_delly.done")
