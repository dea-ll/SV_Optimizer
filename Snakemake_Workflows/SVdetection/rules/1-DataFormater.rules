wildcard_constraints:
    sample = "[^/]+",
    tool   = "[^/]+",
    svtype = "[a-z0-9_-]+",
    date   = "[0-9-]+"

rule dataformater:
    """
    Run the tool-specific DataFormater script to create the JSON file.
    One workdir per tool: <working_folder>/<tool>.
    """
    input:
        parameter_file = lambda wc: config["parameters_files"][wc.tool]
    output:
        done = "done_files/{tool}.dataformater.done",
        json = "done_files/{tool}.DataFormated.json"
    params:
        conda_init = parameters.conda_init,
        conda_env  = parameters.conda_env,
        script     = lambda wc: config["dataformater_scripts"][wc.tool],
        workdir    = lambda wc: f"{config['working_folder']}/{wc.tool}"
    resources:
        nb_cores = 4,
        mem_mb   = 2000
    shell:
        """
        mkdir -p {params.workdir}
        mkdir -p done_files/

        cd {params.workdir}

        source {params.conda_init}
        conda activate {params.conda_env}

        python3 {params.script} --parameter_file={input.parameter_file}

        json_file=$(ls -1 *.DataFormated.json 2>/dev/null | head -n 1)
        if [ -z "$json_file" ]; then
            echo "No DataFormated JSON found in $(pwd)" >&2
            exit 1
        fi

        cp "$json_file" ../done_files/{wildcards.tool}.DataFormated.json

        cd ..

        touch {output.done}
        """
        
rule all_dataformater:
    input:
        expand("done_files/{tool}.dataformater.done", tool=config["tools"])
    output:
        touch("all_dataformater.done")